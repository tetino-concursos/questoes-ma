# Repositorio publico: somente os arquivos necessarios ao site.
# Fontes internas, testes, memoria e backups permanecem no desenvolvimento local.
/*
!/.gitignore
!/CNAME
!/index.html
!/admin.html
!/site.html
!/tetino_assets/
!/.github/
/.github/*
!/.github/scripts/
!/.github/workflows/
/.github/scripts/*
!/.github/scripts/publication-guard.cjs
/.github/workflows/*
!/.github/workflows/publication-guard.yml

# Defesa adicional para segredos mesmo dentro de pastas publicaveis.
*.dpapi
*.p12
*.pfx
*.key
*.pem
*.jks
*.keystore
*.log
